{
  "_comment": "guardrails writes this file from the req 12 interview. This is code that runs on the machine of everyone who clones this repo. It must never fetch anything from the network.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/hooks/protect-paths.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/hooks/regen-openapi-types.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/hooks/inject-rules.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
